    "\u0420\u0435\u0435\u0441\u0442\u0440 \u0441\u043b\u0443\u0436\u0431\u0443 \u043d\u0435 \u043f\u0440\u0430\u0432\u0438\u0442 \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0438\u0442\u0430\u0435\u0442 \u0435\u0451 \u043f\u0430\u0441\u043f\u043e\u0440\u0442.",
    "",
    "\ud83d\udd12 \u0412\u0415\u0420\u0421\u0418\u042f \u0417\u0410\u041a\u0420\u0415\u041f\u041b\u042f\u0415\u0422\u0421\u042f \u0422\u0415\u0413\u041e\u041c, \u0410 \u041d\u0415 \u0412\u0415\u0422\u041a\u041e\u0419. \u0421\u043b\u0435\u0434\u0443\u044f \u0437\u0430 main, \u0434\u0432\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430,",
    "\u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0432\u0448\u0438\u0435 \u041e\u0414\u041d\u0423 \u0418 \u0422\u0423 \u0416\u0415 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0432 \u0440\u0430\u0437\u043d\u044b\u0435 \u0434\u043d\u0438, \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0440\u0430\u0437\u043d\u044b\u0435 \u0443\u0437\u043b\u044b, \u0438 \u043e\u0442\u043b\u0438\u0447\u0438\u0435",
    "\u043d\u0435 \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043e \u043d\u0438\u0433\u0434\u0435 \u2014 \u0441\u0430\u043c\u044b\u0439 \u0434\u043e\u0440\u043e\u0433\u043e\u0439 \u043a\u043b\u0430\u0441\u0441 \u043e\u0442\u043a\u0430\u0437\u043e\u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0430. \u041f\u0440\u0438 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u043e\u043c \u0442\u0435\u0433\u0435",
    "\u0441\u043e\u0441\u0442\u0430\u0432 \u0443\u0437\u043b\u0430 \u0432\u0438\u0434\u0435\u043d \u0432 git diff \u0438 \u043e\u0442\u043a\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u043e\u0439.",
    "\ud83d\uded1 \u0426\u0435\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u0430: \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432 \u0441\u043b\u0443\u0436\u0431\u0435 \u043d\u0435 \u0434\u043e\u0435\u0437\u0436\u0430\u0435\u0442, \u043f\u043e\u043a\u0430 \u0432\u0435\u0440\u0441\u0438\u044e \u0437\u0434\u0435\u0441\u044c \u043d\u0435 \u043f\u043e\u0434\u043d\u044f\u043b\u0438.",
    "\u0417\u043d\u0430\u0447\u0438\u0442 \u043f\u043e\u0434\u044a\u0451\u043c \u0432\u0435\u0440\u0441\u0438\u0438 \u2014 \u0447\u0430\u0441\u0442\u044c \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u0448\u0430\u0433\u0430, \u0442\u0440\u043e\u043d\u0443\u0432\u0448\u0435\u0433\u043e \u0441\u043b\u0443\u0436\u0431\u0443, \u0430 \u043d\u0435 \u0443\u0431\u043e\u0440\u043a\u0430.",
    "",
    "\ud83d\udd12 \u041f\u041e\u0420\u0422 \u0417\u0414\u0415\u0421\u042c \u2014 \u0424\u0410\u041a\u0422\u0418\u0427\u0415\u0421\u041a\u0418\u0419, \u0430 \u043d\u0435 \u0436\u0435\u043b\u0430\u0435\u043c\u044b\u0439. \u0416\u0435\u043b\u0430\u0435\u043c\u044b\u0439 \u0441\u0442\u043e\u0438\u0442 \u0432 \u043f\u0430\u0441\u043f\u043e\u0440\u0442\u0435 \u0441\u043b\u0443\u0436\u0431\u044b;",
    "\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0443\u0437\u0435\u043b \u0438\u0437 \u0431\u043b\u043e\u043a\u0430 24680-24699 \u0438 \u0432\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u044e\u0434\u0430 \u0442\u043e\u0442, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0441\u043b\u0443\u0436\u0431\u0430",
    "\u0432\u0441\u0442\u0430\u043b\u0430. \u0418\u043d\u0430\u0447\u0435 \u0434\u0432\u0435 \u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044b\u0435 \u0441\u043b\u0443\u0436\u0431\u044b \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u043f\u043e\u043f\u0440\u043e\u0441\u044f\u0442 \u043e\u0434\u0438\u043d \u043d\u043e\u043c\u0435\u0440 \u0438 \u043f\u043e\u0434\u0435\u0440\u0443\u0442\u0441\u044f \u043c\u043e\u043b\u0447\u0430.",
    "",
    "\ud83d\uded1 \u0421\u0415\u041a\u0420\u0415\u0422\u041e\u0412 \u0417\u0414\u0415\u0421\u042c \u041d\u0415\u0422 \u041d\u0418\u041a\u041e\u0413\u0414\u0410. \u0424\u0430\u0439\u043b \u043b\u0435\u0436\u0438\u0442 \u0432 git \u0438 \u0443\u0435\u0437\u0436\u0430\u0435\u0442 \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0433\u043e\u0441\u0442\u044e.",
    "\u041a\u043b\u044e\u0447\u0438 \u0436\u0438\u0432\u0451\u0442 \u0432 .env \u0441\u043b\u0443\u0436\u0431\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0438\u0448\u0435\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a \u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 git \u043d\u0435 \u0432\u0445\u043e\u0434\u0438\u0442.",
    "",
    "\u0421\u0442\u043e\u0440\u043e\u0436: npm run check:microservices (\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043f\u0440\u0430\u0432\u0438\u043b \u2014 \u0432 \u0448\u0430\u043f\u043a\u0435 \u0441\u0442\u043e\u0440\u043e\u0436\u0430).",
    "",
    "\ud83d\udd12 \u0422\u0418\u041f \u0423\u0417\u041b\u0410 (553): nodeType \u2014 project (\u00ab\u0415\u0434\u0438\u043d\u044b\u0439 \u043f\u0440\u043e\u0435\u043a\u0442\u00bb: \u043e\u0434\u0438\u043d \u0445\u043e\u0437\u044f\u0438\u043d, \u0432\u0441\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u043f\u043e\u0434 CONFIG \u044f\u0434\u0440\u0430) \u0438\u043b\u0438 factory (\u00ab\u0417\u0430\u0432\u043e\u0434",
    "\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439\u00bb: \u043a\u0430\u0441\u0442\u043e\u043c\u043d\u044b\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u0440\u043e\u0436\u0434\u0430\u044e\u0442\u0441\u044f \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438). \u041d\u0435\u0442 \u043f\u043e\u043b\u044f \u2014 project. \u041c\u0435\u043d\u044f\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e npm run node-type -- set \u043f\u043e \u0441\u043b\u043e\u0432\u0443",
    "\u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430; \u0442\u0438\u043f \u0437\u0430\u0434\u0430\u0451\u0442 \u043e\u0431\u043b\u0438\u043a \u041d\u041e\u0412\u042b\u0425 \u043a\u0430\u0441\u0442\u043e\u043c\u043d\u044b\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f \u043f\u043e \u043e\u0434\u043d\u043e\u043c\u0443."
